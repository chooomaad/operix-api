APP_NAME=Operix
APP_ENV=testing
# Généré via: php artisan key:generate --env=testing  (ou copier l'APP_KEY de dev)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Base de test DÉDIÉE — DOIT être 'operix_test' (garde-fou dans tests/TestCase.php) ──
# NE JAMAIS pointer vers la base de développement/production.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=operix_test
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
MEDIA_DISK=tenant-media
MEDIA_DISK_DRIVER=local

MAIL_MAILER=array
