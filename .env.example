APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Diffusion temps reel.
#
# Production TCN : `ably` (transport WebSocket manage, via le protocole Pusher —
# voir config/broadcasting.php). Developpement local : `reverb` (serveur embarque)
# ou `log` (ecrit les evenements dans un fichier, pour un diagnostic ponctuel).
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Emails transactionnels.
#
# Production : Resend. La cle RESEND_KEY reste EXCLUSIVEMENT cote serveur, jamais
# dans une variable VITE_*, jamais commitee. Le domaine de MAIL_FROM_ADDRESS doit
# etre verifie dans Resend, sinon l'envoi reel echoue.
#
# Developpement : laisser MAIL_MAILER=log ecrit les emails dans storage/logs, ce
# qui suffit a tester le flux sans cle ni domaine.
MAIL_MAILER=resend
RESEND_KEY=
MAIL_FROM_ADDRESS="no-reply@operix-app.com"
MAIL_FROM_NAME="Operix TCN"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Reverb (serveur WebSocket) ────────────────────────────────────────────────
# Valeurs a generer par projet : `php artisan reverb:install` les renseigne.
# Ne jamais reutiliser les identifiants d'un autre environnement.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Exposees au client web par Vite (valeurs publiques, pas le secret).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Ably (production, protocole Pusher) ───────────────────────────────────────
# Une cle Ably a la forme « APPID.KEYID:SECRET ». On la scinde :
#   ABLY_APP_ID     = APPID            (avant le « . »)
#   ABLY_PUBLIC_KEY = APPID.KEYID      (partie publique — exposable au navigateur)
#   ABLY_SECRET     = SECRET           (apres le « : » — SERVEUR UNIQUEMENT, jamais VITE_*)
# Le secret signe /broadcasting/auth cote serveur et ne doit JAMAIS etre commite.
ABLY_APP_ID=
ABLY_PUBLIC_KEY=
ABLY_SECRET=

# Seule la partie PUBLIQUE est exposee au client. Jamais ABLY_SECRET ici.
VITE_ABLY_PUBLIC_KEY="${ABLY_PUBLIC_KEY}"

# Active le transport Reverb en dev local (sinon : Ably si sa cle publique est
# presente, ou temps reel « indisponible »). Ne jamais mettre true en prod TCN.
VITE_REALTIME_ENABLED=false
